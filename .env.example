# Public address of the site. Used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://xiax.com.br

# Shown on the contact page as a fallback. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_EMAIL=

# Xiax's own endpoint that receives the contact form as JSON (n8n, worker, API).
# Leave empty and the form reports that sending is not configured.
CONTACT_WEBHOOK_URL=
