# Public address of the site. Used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://xiax.com.br

# Shown on the contact page as a fallback when the form cannot send.
NEXT_PUBLIC_CONTACT_EMAIL=xiaxdesenvolvimento@gmail.com

# --- Delivery by e-mail (SMTP). Pick ONE of the two setups. ---
# Mailbox that receives the form. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_TO_EMAIL=

# (a) Relay on the VPS itself (postfix/sendmail), no login: host alone turns it on.
#     host.docker.internal is the VPS seen from inside the container.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=25
# Sender shown on the e-mail. Defaults to the SMTP user, then site@<site host>.
CONTACT_FROM_EMAIL=

# (b) Gmail with an app password (https://myaccount.google.com/apppasswords,
#     needs 2-step verification). User + password turn it on; host defaults to Gmail.
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=

# --- Delivery by webhook (optional, can run alongside e-mail). ---
# Xiax's own endpoint that receives the contact form as JSON (n8n, worker, API).
CONTACT_WEBHOOK_URL=

# Shared secret (16+ chars). When set, each webhook body carries an HMAC-SHA256
# signature in the x-xiax-signature header, so the endpoint can refuse forgeries.
CONTACT_WEBHOOK_SECRET=
