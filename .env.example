# Public address of the site. Used for canonical URLs, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://xiax.com.br

# Shown on the contact page as a fallback when the form cannot send.
NEXT_PUBLIC_CONTACT_EMAIL=contato@xiax.com.br

# Xiax's own endpoint that receives the contact form as JSON (n8n, worker, API).
# Leave empty and the form reports that sending is not configured.
CONTACT_WEBHOOK_URL=

# Shared secret (16+ chars). When set, each webhook body carries an HMAC-SHA256
# signature in the x-xiax-signature header, so the endpoint can refuse forgeries.
CONTACT_WEBHOOK_SECRET=
